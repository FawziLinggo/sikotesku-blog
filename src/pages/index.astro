---
import {
  ArrowRight,
  BadgeCheck,
  BookOpen,
  CheckCircle2,
  FileCheck2,
  ShieldCheck,
  Sparkles,
} from "lucide-astro";
import ArticleCard from "../components/ArticleCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE, TOPICS } from "../data/site";
import { getPublishedPosts } from "../utils/posts";

const posts = await getPublishedPosts();
const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
const latestPosts = posts.filter((post) => post.id !== featuredPost?.id).slice(0, 6);
const topicCounts = Object.fromEntries(
  TOPICS.map((topic) => [topic.slug, posts.filter((post) => post.data.category === topic.slug).length]),
);
---

<BaseLayout>
  <section class="home-hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><Sparkles size={14} aria-hidden="true" /> Panduan dari Sikotesku</p>
        <h1>Lebih paham. Lebih siap. <span>Lebih tenang.</span></h1>
        <p class="hero-lead">
          Pelajari psikotes kerja, CV, dan interview dengan penjelasan yang ringkas.
          Setelah itu, lanjutkan ke latihan yang sesuai - tanpa harus menebak mulai dari mana.
        </p>
        <div class="hero-actions">
          <a class="button button-dark" href="#artikel-pilihan">
            Mulai membaca
            <ArrowRight size={16} strokeWidth={2.5} aria-hidden="true" />
          </a>
          <a class="button button-ghost" href={SITE.practiceUrl}>
            Buka latihan gratis
          </a>
        </div>
        <ul class="hero-proof" aria-label="Prinsip Panduan Sikotesku">
          <li><CheckCircle2 size={15} aria-hidden="true" /> Bahasa praktis</li>
          <li><CheckCircle2 size={15} aria-hidden="true" /> Mobile-first</li>
          <li><CheckCircle2 size={15} aria-hidden="true" /> Tanpa janji berlebihan</li>
        </ul>
      </div>

      <div class="hero-visual" aria-label="Alur persiapan yang disarankan">
        <div class="journey-card">
          <div class="journey-card-header">
            <div>
              <span>Peta persiapan</span>
              <strong>Dari bingung menjadi terarah</strong>
            </div>
            <div class="journey-score">3x</div>
          </div>

          <div class="journey-list">
            <div class="journey-step is-current">
              <span class="journey-number">01</span>
              <div>
                <strong>Pahami bentuk tes</strong>
                <p>Kenali tujuan dan aturan dasarnya.</p>
              </div>
              <span class="journey-status">Sekarang</span>
            </div>
            <div class="journey-step">
              <span class="journey-number">02</span>
              <div>
                <strong>Latihan terukur</strong>
                <p>Bangun ritme tanpa memaksakan diri.</p>
              </div>
              <span class="journey-status">Berikutnya</span>
            </div>
            <div class="journey-step">
              <span class="journey-number">03</span>
              <div>
                <strong>Evaluasi kebiasaan</strong>
                <p>Lihat kesalahan, lalu perbaiki satu per satu.</p>
              </div>
              <span class="journey-status">Ulangi</span>
            </div>
          </div>

          <p class="journey-note">Tidak perlu sempurna dalam satu sesi latihan.</p>
        </div>
      </div>
    </div>
  </section>

  <nav class="topic-strip" aria-label="Topik populer">
    <div class="shell topic-strip-inner">
      {TOPICS.map((topic) => (
        <a class="topic-chip" href={`/topik/${topic.slug}/`}>
          <span class="topic-chip-symbol">{topic.symbol}</span>
          {topic.shortLabel}
        </a>
      ))}
    </div>
  </nav>

  <section class="content-section surface-section" aria-labelledby="topik-title">
    <div class="shell">
      <div class="section-heading section-heading-row">
        <div>
          <p class="eyebrow">Pilih jalur belajar</p>
          <h2 id="topik-title">Satu kebutuhan, satu langkah awal.</h2>
        </div>
        <p>
          Tidak harus membaca semuanya. Pilih topik yang paling dekat dengan
          kebutuhan seleksimu saat ini.
        </p>
      </div>

      <div class="topic-grid">
        {TOPICS.map((topic) => (
          <a class="topic-card" data-accent={topic.accent} href={`/topik/${topic.slug}/`}>
            <div class="topic-card-top">
              <span class="topic-card-symbol">{topic.symbol}</span>
              <span class="topic-card-count">{topicCounts[topic.slug]} artikel</span>
            </div>
            <div class="topic-card-copy">
              <h3>{topic.label}</h3>
              <p>{topic.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="artikel-pilihan" class="content-section" aria-labelledby="pilihan-title">
    <div class="shell">
      <div class="section-heading section-heading-row">
        <div>
          <p class="eyebrow"><BookOpen size={14} aria-hidden="true" /> Artikel pilihan</p>
          <h2 id="pilihan-title">Mulai dari fondasi yang benar.</h2>
        </div>
        <a class="section-link" href="/topik/">
          Lihat semua topik <ArrowRight size={15} aria-hidden="true" />
        </a>
      </div>

      {featuredPost ? (
        <div class="articles-grid">
          <ArticleCard post={featuredPost} featured index={0} />
          {latestPosts.map((post, index) => <ArticleCard post={post} index={index + 1} />)}
        </div>
      ) : (
        <div class="empty-state">
          <h2>Artikel sedang dipersiapkan</h2>
          <p>Tim Sikotesku sedang menyiapkan panduan pertama untukmu.</p>
        </div>
      )}
    </div>
  </section>

  <section class="content-section surface-section" aria-labelledby="editorial-title">
    <div class="shell">
      <div class="editorial-panel">
        <div class="editorial-panel-copy">
          <p class="eyebrow eyebrow-light"><ShieldCheck size={14} aria-hidden="true" /> Standar editorial</p>
          <h2 id="editorial-title">Membantu, bukan memberi jalan pintas palsu.</h2>
          <p>
            Kami tidak menerbitkan bocoran soal, diagnosis, atau janji kelulusan.
            Setiap panduan dibuat agar kamu memahami proses dan membangun kebiasaan latihan.
          </p>
          <a class="button button-teal" href="/kebijakan-editorial/">
            Baca kebijakan editorial
            <ArrowRight size={16} strokeWidth={2.5} aria-hidden="true" />
          </a>
        </div>

        <div class="editorial-points">
          <div class="editorial-point">
            <span class="editorial-point-icon"><BadgeCheck size={19} aria-hidden="true" /></span>
            <div>
              <h3>Jelas sumber dan penulisnya</h3>
              <p>Identitas penulis, tanggal terbit, dan pembaruan ditampilkan terbuka.</p>
            </div>
          </div>
          <div class="editorial-point">
            <span class="editorial-point-icon"><FileCheck2 size={19} aria-hidden="true" /></span>
            <div>
              <h3>Contoh selalu sintetis</h3>
              <p>Tidak memakai CV, jawaban, atau hasil asesmen pengguna sebagai bahan artikel.</p>
            </div>
          </div>
          <div class="editorial-point">
            <span class="editorial-point-icon"><ShieldCheck size={19} aria-hidden="true" /></span>
            <div>
              <h3>Klaim produk dijaga realistis</h3>
              <p>Sikotesku membantu latihan; hasil seleksi tetap dipengaruhi banyak faktor.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
