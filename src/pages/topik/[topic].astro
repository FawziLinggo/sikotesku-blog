---
import ArticleCard from "../../components/ArticleCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE, TOPICS, type TopicSlug } from "../../data/site";
import { getPostUrl, getPublishedPosts } from "../../utils/posts";

export function getStaticPaths() {
  return TOPICS.map((topic) => ({ params: { topic: topic.slug }, props: { topic } }));
}

const { topic } = Astro.props as { topic: (typeof TOPICS)[number] };
const posts = (await getPublishedPosts()).filter(
  (post) => post.data.category === (topic.slug as TopicSlug),
);
const topicPath = `/topik/${topic.slug}/`;
const topicAnswer = "answer" in topic ? topic.answer : undefined;
const primaryUrl = "primaryUrl" in topic ? topic.primaryUrl : undefined;
const primaryLabel = "primaryLabel" in topic ? topic.primaryLabel : undefined;
const topicSchemas = [
  {
    "@type": "ItemList",
    "@id": `${SITE.url}${topicPath}#articles`,
    numberOfItems: posts.length,
    itemListElement: posts.map((post, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: post.data.title,
      url: `${SITE.url}${getPostUrl(post)}`,
    })),
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Beranda", item: SITE.url },
      { "@type": "ListItem", position: 2, name: "Topik", item: `${SITE.url}/topik/` },
      { "@type": "ListItem", position: 3, name: topic.label, item: `${SITE.url}${topicPath}` },
    ],
  },
  {
    "@type": "Thing",
    "@id": `${SITE.url}${topicPath}#topic`,
    name: topic.label,
    description: topic.description,
    ...(primaryUrl ? { sameAs: primaryUrl } : {}),
  },
];
---

<BaseLayout
  title={`${topic.label}: Panduan dan Tips Latihan`}
  description={`${topic.description} Baca panduan ${topic.label} dari Tim Sikotesku dan lanjutkan ke latihan yang relevan.`}
  canonical={topicPath}
  pageSchemaType="CollectionPage"
  structuredData={topicSchemas}
>
  <section class="page-hero">
    <div class="shell page-hero-inner">
      <div>
        <h1>{topic.label}</h1>
        <p>{topic.description}</p>
        <div class="topic-page-meta">
          <span class="meta-pill">{posts.length} artikel</span>
          <span class="meta-pill">Bahasa Indonesia</span>
          <span class="meta-pill">Dibaca dari HP</span>
        </div>
        {topicAnswer && (
          <div class="topic-answer">
            <strong>Jawaban singkat</strong>
            <p>{topicAnswer}</p>
            {primaryUrl && primaryLabel && <a href={primaryUrl}>{primaryLabel}</a>}
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="content-section surface-section">
    <div class="shell">
      {posts.length > 0 ? (
        <div class="articles-grid">
          {posts.map((post, index) => <ArticleCard post={post} featured={index === 0} />)}
        </div>
      ) : (
        <div class="empty-state">
          <h2>Panduan sedang disiapkan</h2>
          <p>Topik ini sudah ada dalam peta konten dan akan diisi secara bertahap.</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
