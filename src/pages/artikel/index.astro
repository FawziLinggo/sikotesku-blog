---
import Search from "lucide-astro/Search";
import ArticleCard from "../../components/ArticleCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../data/site";
import { getPostUrl, getPublishedPosts } from "../../utils/posts";

const posts = await getPublishedPosts();
const itemListSchema = {
  "@type": "ItemList",
  "@id": `${SITE.url}/artikel/#articles`,
  numberOfItems: posts.length,
  itemListElement: posts.map((post, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: post.data.title,
    url: `${SITE.url}${getPostUrl(post)}`,
  })),
};
---

<BaseLayout
  title="Semua Artikel Psikotes Kerja dan Karier"
  description="Baca semua artikel Panduan Sikotesku tentang psikotes kerja, latihan angka, penalaran, ketelitian, CV, dan interview."
  pageSchemaType="CollectionPage"
  structuredData={itemListSchema}
>
  <section class="page-hero">
    <div class="shell page-hero-inner">
      <div>
        <h1>Semua artikel, satu tempat.</h1>
        <p>
          Pilih artikel berdasarkan kebutuhanmu. Setiap panduan dirancang untuk
          dibaca singkat lalu langsung dipraktikkan.
        </p>
        <div class="topic-page-meta">
          <span class="meta-pill">{posts.length} artikel</span>
          <span class="meta-pill">Diperbarui bertahap</span>
        </div>
        <form class="search-shortcut" id="article-search-shortcut" action="/cari/" role="search">
          <label for="article-search-query">Cari berdasarkan topik atau pertanyaan</label>
          <div class="search-shortcut-field">
            <Search size={17} strokeWidth={2.2} aria-hidden="true" />
            <input
              id="article-search-query"
              type="search"
              placeholder="Contoh: Kraepelin atau interview"
              autocomplete="off"
            />
            <button type="submit">Cari</button>
          </div>
        </form>
      </div>
    </div>
  </section>

  <section class="content-section surface-section">
    <div class="shell">
      <div class="articles-grid">
        {posts.map((post, index) => <ArticleCard post={post} featured={index === 0} />)}
      </div>
    </div>
  </section>

  <script is:inline>
    document.querySelector("#article-search-shortcut")?.addEventListener("submit", (event) => {
      event.preventDefault();
      const input = document.querySelector("#article-search-query");
      const query = input instanceof HTMLInputElement ? input.value.trim() : "";
      const target = new URL("/cari/", window.location.origin);
      target.hash = query ? new URLSearchParams({ q: query }).toString() : "";
      window.location.assign(target.toString());
    });
  </script>
</BaseLayout>
