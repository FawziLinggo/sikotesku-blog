---
import ChevronRight from "lucide-astro/ChevronRight";
import Clock3 from "lucide-astro/Clock3";
import Info from "lucide-astro/Info";
import RefreshCcw from "lucide-astro/RefreshCcw";
import { render } from "astro:content";
import ArticleCard from "../../components/ArticleCard.astro";
import ArticleCta from "../../components/ArticleCta.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE, getTopic } from "../../data/site";
import {
  formatDate,
  getPostUrl,
  getPublishedPosts,
  type BlogPost,
} from "../../utils/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: BlogPost };
const { Content, headings } = await render(post);
const topic = getTopic(post.data.category);
const published = post.data.publishDate;
const modified = post.data.updatedDate ?? published;
const canonicalPath = getPostUrl(post);
const allPosts = await getPublishedPosts();
const relatedPosts = allPosts
  .filter((candidate) => candidate.id !== post.id && candidate.data.category === post.data.category)
  .slice(0, 3);
const tocHeadings = headings.filter((heading) => heading.depth === 2);

const articleSchema = {
  "@type": "Article",
  "@id": `${SITE.url}${canonicalPath}#article`,
  headline: post.data.title,
  description: post.data.description,
  datePublished: published.toISOString(),
  dateModified: modified.toISOString(),
  inLanguage: "id-ID",
  mainEntityOfPage: `${SITE.url}${canonicalPath}`,
  image: `${SITE.url}/brand/og-sikotesku.png`,
  author: {
    "@type": "Organization",
    name: post.data.author,
    url: `${SITE.url}/penulis/tim-sikotesku/`,
  },
  publisher: { "@id": `${SITE.mainUrl}/#organization` },
  articleSection: topic?.label,
  keywords: post.data.tags.join(", "),
};

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Beranda", item: SITE.url },
    {
      "@type": "ListItem",
      position: 2,
      name: topic?.label,
      item: `${SITE.url}/topik/${post.data.category}/`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: post.data.title,
      item: `${SITE.url}${canonicalPath}`,
    },
  ],
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonical={canonicalPath}
  type="article"
  publishedTime={published}
  modifiedTime={modified}
  structuredData={[articleSchema, breadcrumbSchema]}
>
  <header class="article-hero">
    <div class="shell">
      <ol class="breadcrumbs" aria-label="Breadcrumb">
        <li><a href="/">Beranda</a></li>
        <li><ChevronRight size={12} aria-hidden="true" /></li>
        <li><a href={`/topik/${post.data.category}/`}>{topic?.label}</a></li>
        <li><ChevronRight size={12} aria-hidden="true" /></li>
        <li aria-current="page">Artikel</li>
      </ol>

      <div class="article-title-wrap">
        <h1 data-pagefind-meta="title">{post.data.title}</h1>
        <p class="article-deck">{post.data.description}</p>
        <div class="article-byline">
          <a href="/penulis/tim-sikotesku/">{post.data.author}</a>
          <span><Clock3 size={14} aria-hidden="true" /> {post.data.readingMinutes} menit baca</span>
          <span>Terbit {formatDate(published)}</span>
          {post.data.updatedDate && (
            <span><RefreshCcw size={13} aria-hidden="true" /> Diperbarui {formatDate(modified)}</span>
          )}
        </div>
      </div>
    </div>
  </header>

  <div class="shell article-layout">
    <article class="article-main">
      <div class="article-disclaimer">
        <Info size={17} aria-hidden="true" />
        <span>
          Materi ini membantu persiapan dan latihan. Bukan alat diagnosis psikologis,
          bocoran tes, atau jaminan lolos seleksi.
        </span>
      </div>
      <div class="article-body">
        <Content />
      </div>
      <ArticleCta {...post.data.cta} />

      {relatedPosts.length > 0 && (
        <section class="related-articles" aria-labelledby="related-title" data-pagefind-ignore>
          <h2 id="related-title">Lanjutkan topik ini</h2>
          <div class="articles-grid">
            {relatedPosts.map((relatedPost) => (
              <ArticleCard post={relatedPost} />
            ))}
          </div>
        </section>
      )}
    </article>

    {tocHeadings.length > 0 && (
      <aside class="article-sidebar" data-pagefind-ignore>
        <nav class="article-toc" aria-label="Daftar isi artikel">
          <h2>Isi artikel</h2>
          <ol>
            {tocHeadings.map((heading) => (
              <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ol>
        </nav>
      </aside>
    )}
  </div>
</BaseLayout>
