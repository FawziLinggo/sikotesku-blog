---
import ChevronRight from "lucide-astro/ChevronRight";
import Clock3 from "lucide-astro/Clock3";
import Info from "lucide-astro/Info";
import RefreshCcw from "lucide-astro/RefreshCcw";
import { render } from "astro:content";
import ArticleCard from "../../components/ArticleCard.astro";
import ArticleCta from "../../components/ArticleCta.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE, getTopic } from "../../data/site";
import {
  formatDate,
  getPostUrl,
  getPublishedPosts,
  type BlogPost,
} from "../../utils/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: BlogPost };
const { Content, headings } = await render(post);
const topic = getTopic(post.data.category);
const published = post.data.publishDate;
const modified = post.data.updatedDate ?? published;
const canonicalPath = getPostUrl(post);
const allPosts = await getPublishedPosts();
const relatedPosts = allPosts
  .filter((candidate) => candidate.id !== post.id && candidate.data.category === post.data.category)
  .slice(0, 3);
const tocHeadings = headings.filter((heading) => heading.depth === 2);
const faqItems = post.data.faq ?? [];
const sourceItems = post.data.sources ?? [];

const articleSchema = {
  "@type": "BlogPosting",
  "@id": `${SITE.url}${canonicalPath}#article`,
  headline: post.data.title,
  description: post.data.description,
  datePublished: published.toISOString(),
  dateModified: modified.toISOString(),
  inLanguage: "id-ID",
  mainEntityOfPage: { "@id": `${SITE.url}${canonicalPath}#webpage` },
  isPartOf: { "@id": `${SITE.url}/#website` },
  image: `${SITE.url}/brand/og-sikotesku.png`,
  author: {
    "@type": "Organization",
    "@id": `${SITE.authorUrl}#author`,
    name: post.data.author,
    url: SITE.authorUrl,
  },
  publisher: { "@id": `${SITE.mainUrl}/#organization` },
  articleSection: topic?.label,
  keywords: post.data.tags.join(", "),
  about: {
    "@type": "Thing",
    name: topic?.label ?? post.data.category,
    url: `${SITE.url}/topik/${post.data.category}/`,
    ...(topic && "primaryUrl" in topic ? { sameAs: topic.primaryUrl } : {}),
  },
  mentions: post.data.tags.map((tag) => ({ "@type": "Thing", name: tag })),
  ...(sourceItems.length > 0
    ? {
        citation: sourceItems.map((source) => ({
          "@type": "CreativeWork",
          name: source.name,
          url: source.url,
        })),
      }
    : {}),
};

const faqSchema = faqItems.length > 0
  ? {
      "@type": "FAQPage",
      "@id": `${SITE.url}${canonicalPath}#faq`,
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    }
  : undefined;

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Beranda", item: SITE.url },
    {
      "@type": "ListItem",
      position: 2,
      name: topic?.label,
      item: `${SITE.url}/topik/${post.data.category}/`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: post.data.title,
      item: `${SITE.url}${canonicalPath}`,
    },
  ],
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonical={canonicalPath}
  type="article"
  publishedTime={published}
  modifiedTime={modified}
  articleSection={topic?.label}
  articleTags={post.data.tags}
  structuredData={[articleSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])]}
>
  <header class="article-hero">
    <div class="shell">
      <ol class="breadcrumbs" aria-label="Breadcrumb">
        <li><a href="/">Beranda</a></li>
        <li><ChevronRight size={12} aria-hidden="true" /></li>
        <li><a href={`/topik/${post.data.category}/`}>{topic?.label}</a></li>
        <li><ChevronRight size={12} aria-hidden="true" /></li>
        <li aria-current="page">Artikel</li>
      </ol>

      <div class="article-title-wrap">
        <h1 data-pagefind-meta="title">{post.data.title}</h1>
        <p class="article-deck">{post.data.description}</p>
        <div class="article-byline">
          <a href="/penulis/tim-sikotesku/">{post.data.author}</a>
          <span><Clock3 size={14} aria-hidden="true" /> {post.data.readingMinutes} menit baca</span>
          <span>Terbit {formatDate(published)}</span>
          {post.data.updatedDate && (
            <span><RefreshCcw size={13} aria-hidden="true" /> Diperbarui {formatDate(modified)}</span>
          )}
        </div>
      </div>
    </div>
  </header>

  <div class="shell article-layout">
    <article class="article-main">
      <section class="article-answer" aria-labelledby="answer-title">
        <p class="article-answer-label" id="answer-title">Jawaban singkat</p>
        <p>{post.data.description}</p>
      </section>
      <div class="article-disclaimer">
        <Info size={17} aria-hidden="true" />
        <span>
          Materi ini membantu persiapan dan latihan. Bukan alat diagnosis psikologis,
          bocoran tes, atau jaminan lolos seleksi.
        </span>
      </div>
      <div class="article-body">
        <Content />
      </div>

      {faqItems.length > 0 && (
        <section class="article-faq" aria-labelledby="faq-title">
          <h2 id="faq-title">Pertanyaan yang sering ditanyakan</h2>
          <div class="article-faq-list">
            {faqItems.map((item, index) => (
              <details open={index === 0}>
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      {sourceItems.length > 0 && (
        <section class="article-sources" aria-labelledby="sources-title">
          <h2 id="sources-title">Sumber dan verifikasi</h2>
          <p>Fakta produk pada artikel ini diperiksa melalui halaman publik berikut.</p>
          <ul>
            {sourceItems.map((source) => (
              <li>
                <a href={source.url}>{source.name}</a>
                {source.note && <span>{source.note}</span>}
              </li>
            ))}
          </ul>
        </section>
      )}
      <ArticleCta {...post.data.cta} />

      {relatedPosts.length > 0 && (
        <section class="related-articles" aria-labelledby="related-title" data-pagefind-ignore>
          <h2 id="related-title">Lanjutkan topik ini</h2>
          <div class="articles-grid">
            {relatedPosts.map((relatedPost) => (
              <ArticleCard post={relatedPost} />
            ))}
          </div>
        </section>
      )}
    </article>

    {tocHeadings.length > 0 && (
      <aside class="article-sidebar" data-pagefind-ignore>
        <nav class="article-toc" aria-label="Daftar isi artikel">
          <h2>Isi artikel</h2>
          <ol>
            {tocHeadings.map((heading) => (
              <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ol>
        </nav>
      </aside>
    )}
  </div>
</BaseLayout>
