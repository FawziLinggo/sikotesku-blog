---
import { ArrowUpRight, Menu } from "lucide-astro";
import { SITE } from "../data/site";

const pathname = Astro.url.pathname;
const links = [
  { href: "/", label: "Beranda" },
  { href: "/artikel/", label: "Artikel" },
  { href: "/topik/", label: "Topik" },
  { href: "/tentang/", label: "Tentang" },
];

function isActive(href: string) {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
}
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand-link" href="/" aria-label="Panduan Sikotesku, kembali ke beranda">
      <img src="/brand/icon-192.png" width="42" height="42" alt="" />
      <span class="brand-copy">
        <span>Panduan</span>
        <strong>sikotesku<span>.com</span></strong>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Navigasi utama">
      {links.map((link) => (
        <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>
          {link.label}
        </a>
      ))}
    </nav>

    <a class="button button-dark header-cta" href={SITE.practiceUrl}>
      Mulai latihan
      <ArrowUpRight size={16} strokeWidth={2.5} aria-hidden="true" />
    </a>

    <details class="mobile-menu">
      <summary aria-label="Buka menu">
        <Menu size={21} strokeWidth={2.4} aria-hidden="true" />
      </summary>
      <nav aria-label="Navigasi mobile">
        {links.map((link) => (
          <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>
            {link.label}
          </a>
        ))}
        <a class="mobile-practice-link" href={SITE.practiceUrl}>
          Mulai latihan
          <ArrowUpRight size={16} strokeWidth={2.5} aria-hidden="true" />
        </a>
      </nav>
    </details>
  </div>
</header>
