---
import ArrowRight from "lucide-astro/ArrowRight";

interface Props {
  label: string;
  href: string;
  description: string;
}

const { label, href, description } = Astro.props;
---

<aside class="article-cta" aria-label="Lanjutkan ke latihan Sikotesku" data-pagefind-ignore>
  <div>
    <h2>Ubah bacaan ini menjadi langkah kecil hari ini.</h2>
    <p>{description}</p>
  </div>
  <a class="button button-teal" href={href}>
    {label}
    <ArrowRight size={16} strokeWidth={2.5} aria-hidden="true" />
  </a>
</aside>
