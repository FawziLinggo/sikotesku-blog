{
  "name": "sikotesku-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist --glob \"artikel/*/index.html\" --force-language id --quiet",
