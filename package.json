    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "astro": "7.2.9",
    "lucide-astro": "0.556.0"
  },
  "devDependencies": {
    "pagefind": "1.5.2",
    "wrangler": "4.127.0"
  }
}
